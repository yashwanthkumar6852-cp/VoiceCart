# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==========================================
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://voicecart.vercel.app
APP_URL=https://voicecart.vercel.app
PRESENTER_MODE=false

# Database (Required in production: Neon / Supabase / Render Postgres)
DATABASE_URL=
REDIS_URL=
REDIS_TTL_SECONDS=300

# Auth & Security
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
DEMO_PASSWORD=
GOOGLE_CLIENT_ID=

# Search APIs
SERPAPI_KEY=
APIFY_TOKEN=
AMAZON_PARTNER_TAG=voxacart-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# AI & Speech
SARVAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# OTP / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VoiceCart Security <no-reply@voicecart.app>
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Direct UPI
UPI_ID=pay@voicecart
UPI_PAYEE_NAME=VoiceCart Official
