{
  "name": "voicecart-backend",
  "version": "1.0.0",
  "description": "Production-grade Voice-Controlled Multi-Store Shopping Assistant Backend",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:deploy": "node dist/scripts/migrateDeploy.js || ts-node src/scripts/migrateDeploy.ts",
    "warm-cache": "node dist/scripts/warmCache.js || ts-node src/scripts/warmCache.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "check:api": "ts-node src/scripts/checkApi.ts",
    "auth:check": "ts-node src/scripts/authCheck.ts",
    "images:cache": "ts-node src/scripts/cacheImages.ts",
    "catalog:ingest": "ts-node src/scripts/catalogIngest.ts",
    "catalog:status": "ts-node src/scripts/catalogStatus.ts",
    "catalog:refresh-prices": "ts-node src/scripts/catalogRefreshPrices.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.1",
    "uuid": "^10.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.8.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
