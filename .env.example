# ==========================================
# VOICECART ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and provide your configuration.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==========================================

# ------------------------------------------
# 1. CORE SERVER & RUNTIME (Backend)
# ------------------------------------------
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://voicecart.vercel.app
APP_URL=https://voicecart.vercel.app
PRESENTER_MODE=false

# ------------------------------------------
# 2. DATABASE & CACHING
# Hosted PostgreSQL (Neon / Supabase / Render Postgres)
# In production, DATABASE_URL is REQUIRED (fails fast if missing)
# Redis is optional; if REDIS_URL is empty, PostgreSQL cache is used automatically.
# ------------------------------------------
DATABASE_URL=
REDIS_URL=
REDIS_TTL_SECONDS=300

# ------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
DEMO_PASSWORD=
GOOGLE_CLIENT_ID=

# ------------------------------------------
# 4. LIVE PRODUCT SEARCH & PRICING APIS
# ------------------------------------------
# SerpApi (Live Google Shopping India for Amazon, Flipkart, Meesho)
# Free 100 searches/mo: https://serpapi.com/
SERPAPI_KEY=

# Apify Token (Meesho & E-commerce Scraping Actor)
APIFY_TOKEN=

# Amazon Creators Tag & Associate Program
AMAZON_PARTNER_TAG=voxacart-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ------------------------------------------
# 5. SPEECH RECOGNITION & AI LLM PROVIDERS
# ------------------------------------------
# Sarvam AI (Indian languages & high accuracy Indic STT): https://www.sarvam.ai/
SARVAM_API_KEY=

# Groq (Whisper large-v3 turbo & Llama 3.3): https://console.groq.com/
GROQ_API_KEY=

# Google Gemini API: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API (Optional): https://platform.openai.com/
OPENAI_API_KEY=

# ------------------------------------------
# 6. EMAIL & SMS OTP AUTHENTICATION
# ------------------------------------------
# SMTP (Brevo, Resend, Gmail App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VoiceCart Security <no-reply@voicecart.app>

# SMS (Fast2SMS, Twilio, MSG91)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ------------------------------------------
# 7. PAYMENT GATEWAY & SIMULATION
# ------------------------------------------
UPI_ID=pay@voicecart
UPI_PAYEE_NAME=VoiceCart Official

# ------------------------------------------
# 8. FRONTEND (Vite / Vercel)
# In production on Vercel, leave VITE_API_URL empty if using same-origin vercel.json rewrite (/api -> Render)
# or set to https://<your-render-backend>.onrender.com/api
# ------------------------------------------
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
