# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (.env.example)
# ==========================================
# Leave empty if using vercel.json rewrite (/api -> backend) for same-origin routing
# Or specify full URL: https://<your-backend>.onrender.com/api
VITE_API_URL=

# Supabase Auth / Database (Optional if using backend JWT auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
